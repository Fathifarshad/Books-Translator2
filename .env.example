# ── Server ─────────────────────────────────────────────
PORT=8787
WEB_ORIGIN=http://localhost:5173
APP_SECRET=change-me-to-a-long-random-string   # encrypts API keys in the DB; unset/example → data/secret.key is generated
DATA_DIR=./data
MAX_UPLOAD_MB=200
MAX_PAGES=2000
WORKER_MODE=inline                             # inline | separate
WORKER_CONCURRENCY=3                           # pipeline jobs running side by side (1-8)
OCR=1                                          # read scanned PDF pages with OCR (0 = off)
# SERVE_WEB=1                                  # serve the built web app from the API (set by `pnpm share`)
LOG_LEVEL=info

# ── Engines (defaults; connect providers and choose engines in the app: Settings → «موتور هوش مصنوعی») ──
ENGINE_DEFAULT=agent                           # agent | mock | claude_code | gemini | ollama | openrouter
TUTOR_ENGINE=local                             # local | mock | claude_code | gemini | ollama | openrouter
AGENT_MAX_PENDING=40
AGENT_LEASE_MINUTES=60

# -- Claude Code engine (`claude_code`): the `claude` program on this computer, paid for by your Claude plan --
# CLAUDE_CLI=                                  # full path to claude.exe / claude; found on PATH by default
TRANSLATE_EFFORT=low                           # low | medium | high | xhigh | max - low is fastest and enough

# ── Free providers — keys are entered in Settings and stored encrypted, not here ──
# Optional endpoint overrides (e.g. Ollama on another computer):
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_AUTH_URL=https://openrouter.ai/auth

# ── Web ────────────────────────────────────────────────
VITE_API_URL=http://localhost:8787
