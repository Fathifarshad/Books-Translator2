{
  "name": "@dozabaneh/pdf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PDF → ExtractedBook → BookStructure (pdf.js in a worker thread) + inspect tool.",
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker.ts"
