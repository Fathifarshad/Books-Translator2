{
  "name": "dozabaneh",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"pnpm --filter @dozabaneh/api dev\" \"pnpm --filter @dozabaneh/web dev\"",
    "build": "pnpm -r build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @dozabaneh/web e2e",
    "screens": "pnpm --filter @dozabaneh/web screens"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^26.6.3",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
